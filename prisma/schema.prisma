// Maher Mobile Care — local SQLite database (Prisma ORM).
// The .db file is auto-created on first migrate. 100% offline.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Service {
  id            Int      @id @default(autoincrement())
  customerName  String
  phone         String
  model         String
  technician    String   // NURUL, RONI, ASRAFUL, NAYEM
  problem       String
  totalBill     Int      @default(0)
  advance       Int      @default(0) // জমা
  due           Int      @default(0) // বাকি (auto: totalBill - advance)
  status        String   @default("Pending") // Pending, In-Progress, Completed, Delivered, Returned
  shopExpense   String?  // দোকান খরচ: raw keypad code (*J#) or a number
  expenseAmount Int      @default(0) // decoded numeric expense for profit calc
  partsShop     String?  // পার্টস কেনার দোকান (internal only, never on a receipt)
  returnedAt    DateTime? // set when an unfinished job is handed back
  refundAmount  Int      @default(0) // cash returned to the customer
  refundNote    String?  // internal note about the return/refund
  damageLoss    Int      @default(0) // internal: shop-borne damage repair/compensation
  damageNote    String?  // internal: what the technician damaged
  serviceDate   DateTime @default(now())
  archived      Boolean  @default(false) // soft-delete: hidden from lists/stats, restorable
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serviceDate])
  @@index([technician])
  @@index([status])
  @@index([archived])
}

/// Shop employees. `Service.technician` stays a plain String on purpose: a
/// foreign key would break the backup/restore column validation, which
/// deliberately never references this table.
model Technician {
  id        Int      @id @default(autoincrement())
  name      String   @unique // stored normalized: trim() + UPPERCASE
  isActive  Boolean  @default(true) // false = left the shop (soft-delete)
  createdAt DateTime @default(now())

  @@index([isActive])
}
