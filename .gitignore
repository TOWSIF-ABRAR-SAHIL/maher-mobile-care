# dependencies
/node_modules

# next.js
/.next/
/out/
/lobu windows/

# production
/build

# misc
.DS_Store
*.pem
# The admin keygen keypair is intentionally versioned in this PRIVATE repo so
# the isolated licensing suite can mint test keys. It must never be copied into
# out/MAHER/ or any shop-facing package.
!tools/keygen-crm/keys/private.pem
!tools/keygen-crm/keys/public.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (DATABASE_URL lives here)
.env
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts

# local SQLite database (created automatically on first run)
/data/
*.db
*.db-journal
*.db-shm
*.db-wal

# machine-specific trial/activation state written beside the dev database
/prisma/maher-license-state.json

/lib/generated/prisma

# agent tooling (skills installed locally per editor; the set is pinned
# in skills-lock.json, the installed copies stay out of git)
/.agents/
/.claude/
/.windsurf/
/.freebuff/
